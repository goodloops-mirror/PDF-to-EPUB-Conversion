# Copy to .env (gitignored). Shell syntax: quote values containing spaces.
# Path to the source PDF
INPUT_PDF=
# Where the EPUB goes
OUTPUT_DIR=output
# Watermark text to strip (page-diagonal and footer), comma-separated
WATERMARK_TERMS=
# Extra regex patterns for lines to drop, separated by ;;
EXCLUDE_PATTERNS=
# Optional overrides
EPUB_TITLE=
EPUB_AUTHOR=
# true to drop page-number lines ("2.", "48.") that make no sense in reflowable text
STRIP_PAGE_NUMBERS=false
